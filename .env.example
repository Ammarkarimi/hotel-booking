# Database (PostgreSQL)
# Local Docker: postgresql://hotel:hotel@localhost:5432/hotel_billing?schema=public
# Neon/Supabase/Vercel Postgres: use the connection string from your provider
DATABASE_URL="postgresql://hotel:hotel@localhost:5432/hotel_billing?schema=public"

# Auth — required in production (use a long random string, e.g. openssl rand -base64 32)
JWT_SECRET="change-me-in-production"
# Optional: locks secrets hotels save in Settings (their Razorpay key secret). Falls back to JWT_SECRET.
# SETTINGS_SECRET="another-long-random-string"

# Old file storage. The app no longer stores files (ID copies were removed); these are only
# used to delete the copies saved before. New installs can leave them out.
# STORAGE_DRIVER="local"
# UPLOAD_DIR="./uploads"
# BLOB_READ_WRITE_TOKEN=""

# Node environment (set automatically on most hosts)
NODE_ENV="development"

# Show the demo sign-in accounts on the login page in production (for demo sites only)
NEXT_PUBLIC_DEMO_MODE="false"

# Software provider's owner panel at /platform (create hotels, track monthly payments).
# This is the only owner-panel account. /platform stays locked until both are set.
# The password must be at least 10 characters.
PLATFORM_ADMIN_EMAIL=""
PLATFORM_ADMIN_PASSWORD=""

# Landing page contact buttons (optional). WhatsApp number with country code.
SALES_WHATSAPP=""
SALES_EMAIL=""
# Time zone that decides "this month" for subscriptions (default Asia/Kolkata)
# PLATFORM_TIMEZONE="Asia/Kolkata"
