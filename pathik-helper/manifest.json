{
  "manifest_version": 3,
  "name": "Pathik helper for Hotel Manager",
  "short_name": "Pathik helper",
  "version": "1.1.1",
  "description": "Fills Pathik's Add Guest form (pathik.guru) with a guest from Hotel Manager, including the other adults in the room.",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["https://pathik.guru/*", "https://www.pathik.guru/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://hotel-booking-8fzz.vercel.app/*", "http://localhost/*", "http://127.0.0.1/*"],
      "js": ["app-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://pathik.guru/*", "https://www.pathik.guru/*"],
      "js": ["pathik-fill.js"],
      "run_at": "document_idle"
    }
  ]
}
