generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A hotel that pays to use the software. Every other record belongs to exactly one hotel,
// and hotels never see each other's data.
model Hotel {
  id                   String                @id @default(cuid())
  name                 String
  slug                 String                @unique // booking website address: /book/<slug>
  status               String                @default("active") // active, suspended
  contactName          String?
  contactPhone         String?
  contactEmail         String?
  city                 String?
  monthlyFee           Float                 @default(0)
  billingStart         String // first month that is charged, "YYYY-MM"
  notes                String?
  bookingSeq           Int                   @default(1000) // last booking number handed out
  banquetSeq           Int                   @default(0) // last banquet (function) number handed out
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  staff                Staff[]
  settings             HotelSettings?
  seasonalRates        SeasonalRate[]
  rooms                Room[]
  guests               Guest[]
  guestDocuments       GuestDocument[]
  bookings             Booking[]
  charges              Charge[]
  payments             Payment[]
  bills                Bill[]
  activities           ActivityLog[]
  expenses             Expense[]
  shifts               Shift[]
  shiftTransfers       ShiftTransfer[]
  guestForms           GuestForm[]
  idChecks             IdCheck[]
  rateTipsSeen         RateTipSeen[]
  subscriptionPayments SubscriptionPayment[]
  banquetHalls         BanquetHall[]
  banquetMenus         BanquetMenu[]
  banquets             Banquet[]
  banquetItems         BanquetItem[]
}

// Money a hotel paid the software provider for its monthly subscription.
model SubscriptionPayment {
  id          String   @id @default(cuid())
  hotelId     String
  month       String // the month this payment is for, "YYYY-MM"
  amount      Float
  clearsMonth Boolean  @default(true) // false = part payment, the month is still due
  method      String   @default("upi") // cash, upi, bank_transfer, card, other
  reference   String?
  notes       String?
  paidOn      DateTime @db.Date
  createdAt   DateTime @default(now())
  hotel       Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([hotelId, month])
}

model Staff {
  id           String        @id @default(cuid())
  hotelId      String
  email        String        @unique
  passwordHash String
  name         String
  role         String        @default("staff") // admin, staff
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  lastLoginAt  DateTime?
  activities   ActivityLog[]
  shifts       Shift[]
  hotel        Hotel         @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([hotelId])
}

// One row per hotel holding its profile and preferences.
model HotelSettings {
  id                  String   @id @default(cuid())
  hotelId             String   @unique
  hotelName           String   @default("My Hotel")
  tagline             String?
  address             String?
  city                String?
  phone               String?
  email               String?
  gstin               String?
  currency            String   @default("INR")
  timezone            String   @default("Asia/Kolkata")
  taxMode             String   @default("flat") // flat, india_gst
  taxRate             Float    @default(12) // used when taxMode = flat
  gstSlabs            String   @default("[{\"upTo\":1000,\"rate\":0},{\"upTo\":7500,\"rate\":5},{\"upTo\":null,\"rate\":18}]")
  extrasTaxRate       Float    @default(5) // tax on food, laundry and other extras
  weekendSurcharge    Float    @default(0) // % change on Friday & Saturday nights
  checkInTime         String   @default("12:00")
  checkOutTime        String   @default("11:00")
  invoicePrefix       String   @default("INV")
  bookingTerms        String?
  websiteEnabled      Boolean  @default(true)
  websiteAbout        String?
  staffShifts         Boolean  @default(true) // front-desk staff start and end a shift, with a handover note
  ownerWhatsapp       String? // where staff send their shift report
  frontDeskStaff      Int      @default(1) // how many people can be on shift at the same time
  // WhatsApp messages to guests in the owner's own words; null = the default wording (src/lib/messages.ts)
  msgBooking          String?
  msgCheckIn          String?
  msgCheckOut         String?
  // Rate tips: suggest a lower price for rooms still empty for tonight (src/lib/rate-tips.ts)
  rateTips            Boolean  @default(true)
  rateTipsFrom        String   @default("13:00") // no tips before this time: mornings sell at the usual price
  rateTipsMaxDiscount Float    @default(20) // the biggest cut a tip may suggest, in %
  rateTipsFloors      String   @default("{}") // JSON { roomType: lowest price per night the owner accepts }
  rateTipsStaff       Boolean  @default(true) // front-desk staff see the tips too, not only the owner
  pathik              Boolean  @default(true) // show "Fill in Pathik" (the Gujarat police guest register)
  // Banquets (functions in the hotel's halls): default GST % for new functions, invoice series and terms
  banquetFoodGst      Float    @default(5) // food and drinks served at a function
  banquetHallGst      Float    @default(18) // hall rent
  banquetItemGst      Float    @default(18) // decoration, DJ, sound and other services
  banquetPrefix       String   @default("BQ") // banquet invoice numbers: BQ-1, BQ-2…
  banquetTerms        String? // printed on banquet quotations and confirmations (advance, cancellation, timings…)
  updatedAt           DateTime @updatedAt
  hotel               Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
}

// Date ranges where room prices go up or down (festivals, holidays, off-season).
model SeasonalRate {
  id        String   @id @default(cuid())
  hotelId   String
  name      String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date // inclusive
  roomType  String? // null = all room types
  percent   Float // +20 = 20% more expensive, -10 = 10% cheaper
  createdAt DateTime @default(now())
  hotel     Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([hotelId])
}

model Room {
  id                String    @id @default(cuid())
  hotelId           String
  roomNumber        String
  type              String // single, double, twin, suite, deluxe, family, dormitory
  floor             String?
  capacity          Int       @default(2)
  pricePerNight     Float
  description       String?
  amenities         String    @default("[]") // JSON array stored as string
  status            String    @default("available") // available, occupied, maintenance
  housekeeping      String    @default("clean") // clean, dirty, cleaning
  houseKeeperName   String?
  housekeepingNotes String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  bookings          Booking[]
  hotel             Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)
}

model Guest {
  id          String          @id @default(cuid())
  hotelId     String
  firstName   String
  lastName    String          @default("")
  email       String?
  phone       String
  nationality String          @default("Indian")
  address     String? // house, street and area
  locality    String? // area or locality, asked by the police form (Pathik)
  city        String?
  district    String?
  state       String?
  pinCode     String?
  idType      String?
  idNumber    String?
  company     String?
  gstin       String?
  dateOfBirth DateTime?       @db.Date
  passportNo  String?
  visaNo      String?
  notes       String?
  vip         Boolean         @default(false)
  blacklisted Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  documents   GuestDocument[]
  bookings    Booking[]
  hotel       Hotel           @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([hotelId, phone])
}

model GuestDocument {
  id          String     @id @default(cuid())
  hotelId     String
  // A copy uploaded by the guest on a WhatsApp guest form belongs to the form until the
  // desk makes the booking; then it moves to the guest's profile.
  guestId     String?
  guestFormId String?
  person      String? // null = the guest; otherwise the name of someone staying with them
  type        String // aadhar, pan, passport, driving_licence, voter_id, visa, other
  fileName    String
  filePath    String
  mimeType    String?
  createdAt   DateTime   @default(now())
  guest       Guest?     @relation(fields: [guestId], references: [id], onDelete: Cascade)
  guestForm   GuestForm? @relation(fields: [guestFormId], references: [id], onDelete: SetNull)
  hotel       Hotel      @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([hotelId])
  @@index([guestFormId])
}

// A form sent to a guest on WhatsApp. The guest fills in their details and uploads ID copies;
// the front desk then picks the room and the booking is made from what they filled in.
model GuestForm {
  id           String          @id @default(cuid())
  hotelId      String
  token        String          @unique // the secret part of the link sent to the guest
  phone        String // the number it was sent to
  guestName    String? // the name typed by staff, shown to the guest
  checkInDate  DateTime? // dates suggested by staff, if any
  checkOutDate DateTime?
  status       String          @default("sent") // sent, submitted, booked, cancelled
  details      String? // JSON: everything the guest filled in
  sentById     String?
  sentByName   String
  createdAt    DateTime        @default(now())
  expiresAt    DateTime // the guest can fill it in until then
  submittedAt  DateTime?
  bookingId    String? // the booking made from it
  closedAt     DateTime?
  closedBy     String?
  documents    GuestDocument[]
  hotel        Hotel           @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([hotelId, status])
}

model Booking {
  id                  String    @id @default(cuid())
  hotelId             String
  number              Int // counts up per hotel, starting at 1001
  publicToken         String    @unique @default(cuid())
  guestId             String
  roomId              String
  checkInDate         DateTime
  checkOutDate        DateTime
  actualCheckIn       DateTime?
  actualCheckOut      DateTime?
  status              String    @default("reserved") // reserved, checked_in, checked_out, cancelled, no_show
  source              String    @default("walk_in") // walk_in, phone, website, booking_com, makemytrip, airbnb, agoda, travel_agent, other
  ratePerNight        Float     @default(0) // agreed base price per night
  fixedRate           Boolean   @default(false) // true = ignore weekend / seasonal price changes
  gstRate             Float? // GST % on the room for this booking; null = the default from Settings
  discount            Float     @default(0)
  adults              Int       @default(1)
  children            Int       @default(0)
  notes               String?
  cancelReason        String?
  // For police guest registration (Pathik and others), usually filled in by the guest on the WhatsApp form.
  comingFrom          String?
  goingTo             String?
  vehicleNumber       String?
  vehicleType         String? // two_wheeler, four_wheeler, other (asked by the police form)
  pathikAt            DateTime? // when the front desk marked the stay as entered in Pathik
  pathikByName        String?
  companions          String? // JSON: [{ name, phone? }] for the other adults in the room
  originalPrice       String? // JSON: the price first agreed, saved on the first Edit bill: { ratePerNight, fixedRate, discount, gstRate }; null = bill never edited
  createdById         String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  // Bookings from booking sites (MakeMyTrip, Goibibo, Booking.com…): the bill stays on the
  // gross amount; these record what the site deducts and actually pays the hotel.
  otaReference        String? // the booking site's own booking ID, to match its statements
  payoutAmount        Float? // what the site pays the hotel after deductions; null = not entered
  payoutCommission    Float     @default(0)
  payoutCommissionGst Float     @default(0)
  payoutTcs           Float     @default(0)
  payoutTds           Float     @default(0)
  payoutReceivedOn    DateTime? @db.Date // when the money reached the bank; null = still waiting
  payoutBankRef       String? // UTR or bank reference of the site's transfer
  guest               Guest     @relation(fields: [guestId], references: [id])
  room                Room      @relation(fields: [roomId], references: [id])
  payments            Payment[]
  charges             Charge[]
  bill                Bill?
  idChecks            IdCheck[]
  hotel               Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@unique([hotelId, number])
  @@index([roomId, checkInDate, checkOutDate])
  @@index([hotelId, status])
}

// Extra items added to a guest's bill (food, laundry, minibar, etc).
model Charge {
  id          String   @id @default(cuid())
  hotelId     String
  bookingId   String
  category    String   @default("other") // food, laundry, minibar, transport, extra_bed, damage, other
  description String
  quantity    Float    @default(1)
  unitPrice   Float
  amount      Float
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  hotel       Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([hotelId])
}

model Payment {
  id         String   @id @default(cuid())
  hotelId    String
  // A payment is for a room booking or for a banquet (function): exactly one of the two is set.
  bookingId  String?
  banquetId  String?
  amount     Float
  method     String // cash, card, upi, bank_transfer, other
  type       String   @default("advance") // advance, balance, full, refund
  status     String   @default("completed") // pending, completed, failed
  reference  String?
  notes      String?
  receivedBy String?
  paidAt     DateTime @default(now())
  createdAt  DateTime @default(now())
  booking    Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  banquet    Banquet? @relation(fields: [banquetId], references: [id], onDelete: Cascade)
  hotel      Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([hotelId, paidAt])
  @@index([banquetId])
}

// Final invoice snapshot created when the guest checks out.
model Bill {
  id                String   @id @default(cuid())
  hotelId           String
  invoiceNumber     String?
  bookingId         String   @unique
  roomCharges       Float
  additionalCharges Float    @default(0)
  taxRate           Float    @default(12)
  taxAmount         Float
  roomTax           Float    @default(0)
  extrasTax         Float    @default(0)
  discount          Float    @default(0)
  totalAmount       Float
  nights            Int
  generatedAt       DateTime @default(now())
  booking           Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  hotel             Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@unique([hotelId, invoiceNumber])
}

// Money the hotel spends: salaries, electricity, supplies, repairs and so on.
// Subtracted from earnings in Reports to show profit.
model Expense {
  id          String   @id @default(cuid())
  hotelId     String
  date        DateTime @db.Date // the day the money was spent
  category    String   @default("other") // salaries, utilities, supplies, kitchen, laundry, repairs, rent, internet_phone, commission, marketing, taxes_fees, other
  title       String
  description String?
  amount      Float
  method      String   @default("cash") // cash, upi, card, bank_transfer, other
  addedById   String?
  addedBy     String? // name of the person who wrote it down
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  hotel       Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([hotelId, date])
}

/// One front-desk shift: when a staff member started and ended work, and the handover note they left.
model Shift {
  id           String          @id @default(cuid())
  hotelId      String
  staffId      String?
  staffName    String
  startedAt    DateTime        @default(now())
  startNote    String?
  endedAt      DateTime?
  handoverNote String?
  endCode      String? // the code shown on screen that must be typed to end the shift
  endedBy      String? // the owner's name when the owner closed a shift the staff forgot to end
  endReason    String? // staff (ended it themselves), owner (closed by the owner), transferred (handed over to the next person)
  handedOverTo String? // who took over the shift, when it was handed over
  summary      String? // JSON: check-ins, check-outs, bookings and money, fixed when the shift ends
  reportText   String? // the shift report exactly as saved; editing it in WhatsApp does not change this
  ownerSeenAt  DateTime?
  staff        Staff?          @relation(fields: [staffId], references: [id], onDelete: SetNull)
  hotel        Hotel           @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  transfers    ShiftTransfer[]

  @@index([hotelId, startedAt])
  @@index([hotelId, staffId, endedAt])
}

/// A request to take over someone's shift when the front desk is full. The person on shift (or the owner) accepts or declines.
model ShiftTransfer {
  id            String    @id @default(cuid())
  hotelId       String
  fromShiftId   String
  fromStaffName String
  toStaffId     String
  toStaffName   String
  startNote     String? // the new person's note for the start of their shift
  status        String    @default("pending") // pending, accepted, declined, cancelled
  createdAt     DateTime  @default(now())
  respondedAt   DateTime?
  respondedBy   String?
  fromShift     Shift     @relation(fields: [fromShiftId], references: [id], onDelete: Cascade)
  hotel         Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([hotelId, status])
  @@index([fromShiftId])
}

model ActivityLog {
  id        String   @id @default(cuid())
  hotelId   String
  staffId   String?
  staffName String
  action    String
  details   String?
  createdAt DateTime @default(now())
  staff     Staff?   @relation(fields: [staffId], references: [id], onDelete: SetNull)
  hotel     Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([hotelId, createdAt])
}

// An ID checked at the front desk for one adult in a booking: the receptionist looks at the
// original and ticks it. Nothing from the ID itself is saved, only which kind, who and when.
model IdCheck {
  id            String   @id @default(cuid())
  hotelId       String
  bookingId     String
  person        String? // null = the guest who booked; otherwise the name of another adult in the room
  method        String // id_seen (ticked at the desk); aadhaar_qr for checks made with the earlier QR scanner
  idType        String? // aadhar, passport, driving_licence, voter_id, pan, other
  checkedById   String?
  checkedByName String
  createdAt     DateTime @default(now())
  booking       Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  hotel         Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

// Uploaded files waiting to be deleted from storage (for example Aadhaar copies saved before
// Aadhaar stopped being stored). The app deletes them in small batches while it is in use.
model FileCleanup {
  filePath  String   @id
  createdAt DateTime @default(now())
}

// Someone signed in typed "I have seen" on a rate tip. A tip is one price for one room type on one
// night (tipKey = "2026-11-02|deluxe|2400"); a lower price later in the day is a new tip.
model RateTipSeen {
  id        String   @id @default(cuid())
  hotelId   String
  staffId   String
  staffName String
  tipKey    String
  createdAt DateTime @default(now())
  hotel     Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@unique([hotelId, staffId, tipKey])
  @@index([hotelId, createdAt])
}

// ---------- Banquets: functions (weddings, parties, meetings) in the hotel's halls ----------

model BanquetHall {
  id        String    @id @default(cuid())
  hotelId   String
  name      String // "Crystal Hall", "Lawn"
  capacity  Int       @default(0) // most guests it holds; 0 = not set
  rent      Float     @default(0) // usual hall rent for one function, before GST
  notes     String? // AC, stage, parking…
  active    Boolean   @default(true) // switched off = no new functions, old ones keep it
  createdAt DateTime  @default(now())
  banquets  Banquet[]
  hotel     Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@unique([hotelId, name])
}

model BanquetMenu {
  id            String   @id @default(cuid())
  hotelId       String
  name          String // "Gujarati thali", "Gold non-veg buffet"
  foodType      String   @default("veg") // veg, non_veg, jain, mixed
  pricePerPlate Float
  items         String? // the dishes, one per line
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  hotel         Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@unique([hotelId, name])
}

model Banquet {
  id            String        @id @default(cuid())
  hotelId       String
  number        Int // counts up per hotel: 1, 2, 3…
  status        String        @default("enquiry") // enquiry, tentative, confirmed, completed, cancelled
  // The customer (the host who books and pays)
  customerName  String
  phone         String
  email         String?
  company       String?
  gstin         String?
  address       String?
  // The function
  eventType     String        @default("wedding") // wedding, reception, engagement, birthday, anniversary, corporate, conference, religious, other
  eventName     String? // "Sharma–Verma reception"
  hallId        String
  eventDate     DateTime      @db.Date
  session       String        @default("dinner") // breakfast, lunch, hi_tea, dinner, full_day
  startTime     String // "19:00"
  endTime       String // "23:00"; earlier than the start = after midnight
  expectedPax   Int // guests expected
  guaranteedPax Int           @default(0) // plates the host pays for even if fewer come
  actualPax     Int? // plates actually served, entered after the function
  seating       String? // round tables, theatre, classroom, U-shape, cocktail
  // Food: one menu at a price per plate (other plates go in the extra items)
  menuName      String?
  foodType      String        @default("veg")
  menuItems     String? // the dishes, one per line (copied from the menu, can be changed)
  platePrice    Float         @default(0)
  foodGst       Float         @default(5)
  hallRent      Float         @default(0)
  hallGst       Float         @default(18)
  discount      Float         @default(0) // on the whole bill, before GST
  requirements  String? // decoration, stage, DJ, flowers… for the staff
  notes         String?
  followUpOn    DateTime?     @db.Date // enquiry: call back on; tentative: hold the hall until
  invoiceNumber String? // set when the final bill is made
  billedAt      DateTime?
  cancelReason  String?
  cancelledAt   DateTime?
  createdById   String?
  createdByName String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  hall          BanquetHall   @relation(fields: [hallId], references: [id])
  items         BanquetItem[]
  payments      Payment[]
  hotel         Hotel         @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@unique([hotelId, number])
  @@unique([hotelId, invoiceNumber])
  @@index([hotelId, eventDate])
  @@index([hallId, eventDate])
}

model BanquetItem {
  id          String   @id @default(cuid())
  hotelId     String
  banquetId   String
  category    String   @default("other") // extra_plates, drinks, decoration, sound_dj, lighting, photography, equipment, extra_hours, rooms, damage, other
  description String
  quantity    Float    @default(1)
  unitPrice   Float
  amount      Float
  gstRate     Float    @default(18)
  createdAt   DateTime @default(now())
  banquet     Banquet  @relation(fields: [banquetId], references: [id], onDelete: Cascade)
  hotel       Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([hotelId])
}
